{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "opengem",
  "version": "0.1.0",
  "identifier": "com.opengem.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "opengem",
        "width": 1600,
        "height": 1000,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOTU3RUM2MkI5MkUzNkYKUldSdjQ1SXJ4bjZWbXVHd0Job0ZzWTBsRkNiUlFpcU5FNWdXcVRkOENFNjNicjJsblJVeDFLMCsK",
      "endpoints": [
        "https://github.com/accidnet/opengem/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
